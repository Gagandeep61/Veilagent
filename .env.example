# VEILAGENT Environment Configuration
# Problem Statement: 26171 (Smart India Hackathon / ISRO)

# Gemini API Key (Required for live VLM reasoning, not needed when MOCK_VLM=true)
GEMINI_API_KEY=""

# Model choice: gemini-3.1-flash-lite or gemini-3.8-flash
GEMINI_MODEL="gemini-3.1-flash-lite"

# Mock VLM mode (true = deterministic local mock, false = live Gemini VLM)
MOCK_VLM="true"

# Server Port
PORT=3000

# Backend URL for the Chrome Extension
VITE_API_URL="http://localhost:3000"

# Allowed Extension Origin for CORS (e.g. chrome-extension://<id> or http://localhost:3000)
ALLOWED_EXTENSION_ORIGIN="*"
